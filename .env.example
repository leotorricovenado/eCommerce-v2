# Copiar a .env (no se versiona). Todas son opcionales: sin ellas la app funciona 100 % local
# y solo se omite la integración de demo con el bot.

# URL pública del backend del bot (gv-agent-core), sin slash final. Ej. túnel ngrok.
VITE_BOT_API_BASE_URL=

# Debe coincidir con una de las keys en INTEGRATION_API_KEYS del backend del bot.
VITE_BOT_API_KEY=

# Número de WhatsApp Business del bot, formato internacional sin "+" ni espacios (ej. 59177346862).
# Lo usa el botón "Volver a WhatsApp" (link wa.me). Sin él, el botón vuelve al Home.
VITE_BOT_WHATSAPP_NUMBER=
